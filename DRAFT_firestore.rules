rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'somasina1999@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    incoming().uid == request.auth.uid &&
                    incoming().displayName is string && incoming().displayName.size() <= 100 &&
                    incoming().role != 'admin';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Services Catalog (Public readable, admin editable)
    match /services/{serviceId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Service Requests (Customer tickets)
    match /service_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'Submitted' &&
                    incoming().description is string && incoming().description.size() <= 3000 &&
                    incoming().customerName is string && incoming().customerName.size() <= 100;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['description', 'customerNote', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Products (Public read, admin write)
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'Submitted' &&
                    incoming().customerName is string && incoming().customerName.size() <= 100;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Local Service Providers (Public read, admin write)
    match /local_providers/{providerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                    resource.data.userId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
